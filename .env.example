# ── ALREADY ACTIVE ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # Claude — text + video scripts
GEMINI_API_KEY=               # Gemini 2.5 Flash — image generation
ELEVENLABS_API_KEY=           # ElevenLabs — voiceover
ELEVENLABS_VOICE_ID=          # ElevenLabs voice ID
LINKEDIN_ACCESS_TOKEN=        # LinkedIn posting
LINKEDIN_PERSON_URN=          # LinkedIn person identifier
LINKEDIN_CLIENT_ID=           # LinkedIn OAuth
LINKEDIN_CLIENT_SECRET=       # LinkedIn OAuth

# ── RUNWAY (animated video clips inside Reels) ────────────────────────────────
RUNWAY_API_KEY=               # Runway Gen-3 — image-to-video animated clips (optional, falls back to static image)

# ── TOPAZ LABS (video upscaling) ──────────────────────────────────────────────
TOPAZ_API_KEY=                # Topaz Labs API — 2× upscale vertical Reels (1080→4K) before upload

# ── ADD FOR v2 ────────────────────────────────────────────────────────────────
SUPABASE_URL=                 # Supabase — project URL (https://xxxx.supabase.co)
SUPABASE_SECRET_KEY=          # Supabase — service role key (bypasses RLS) — REQUIRED
SUPABASE_KEY=                 # Supabase — anon/publishable key (optional)
NEWS_API_KEY=                 # NewsAPI.org — breaking news
OPENAI_API_KEY=               # OpenAI Whisper — YouTube transcription
SHOTSTACK_API_KEY=            # Shotstack — sandbox key (stage endpoint, watermarked)
SHOTSTACK_API_KEY_PROD=       # Shotstack — production key (v1 endpoint, no watermark)
SHOTSTACK_ENV=production      # Set to "production" for live renders, "sandbox" for testing
THREADS_ACCESS_TOKEN=         # Meta Threads API (add threads_manage_insights scope for analytics/)
THREADS_USER_ID=              # Threads user ID (fetched automatically)
INSTAGRAM_WEBHOOK_VERIFY_TOKEN= # Any secret string — must match Meta webhook dashboard
REVIEW_TOKEN=                 # Secret guarding the /review video-approval endpoints (falls back to INSTAGRAM_WEBHOOK_VERIFY_TOKEN)
TIKTOK_ACCESS_TOKEN=          # TikTok Content Posting API
INSTAGRAM_ACCESS_TOKEN=       # Meta Graph API — Instagram Business (add instagram_manage_insights for analytics/)
INSTAGRAM_BUSINESS_ID=        # Instagram Business Account ID
YOUTUBE_CLIENT_ID=            # YouTube Data API OAuth
YOUTUBE_CLIENT_SECRET=        # YouTube Data API OAuth
YOUTUBE_REFRESH_TOKEN=        # YouTube OAuth refresh token
FIRECRAWL_API_KEY=            # Firecrawl — news URL search for NEWS image mode (app.firecrawl.dev)
COMPETITOR_IG_HANDLES=        # CSV of rival IG usernames to mine for design ideas, e.g. brandA,brandB (needs INSTAGRAM_BUSINESS_ID)

# ── HIGGSFIELD (cinematic AI video + image generation) ───────────────────────
USE_HIGGSFIELD=true              # Set to "true" to route video generation through Higgsfield
HIGGSFIELD_VIDEO_MODEL=seedance_2_0  # Default: seedance_2_0 (SOTA). Options: kling3_0, veo3_1, minimax_hailuo_2_3
HIGGSFIELD_IMAGE_MODEL=gpt_image_2   # Default: gpt_image_2. Options: nano_banana_2, text2image_soul_v2
# Auth: run `higgsfield auth login` once on the machine — stored locally, no env var needed
# Railway: add `npm install -g @higgsfield/cli && higgsfield auth login` to your setup script

# ── WHITE-LABEL OVERRIDES (optional — for client deployments) ─────────────────
BRAND_AUTHOR=                 # e.g. "Jane Smith"
BRAND_TITLE=                  # e.g. "Founder • Acme Agency"
BRAND_HANDLE=                 # e.g. "@JaneSmith"
BRAND_NICHE=                  # e.g. "real estate automation"
BRAND_AUDIENCE=               # e.g. "real estate agents, brokers"
BRAND_PLATFORMS=              # comma-separated: linkedin,tiktok,instagram
